<?xml version="1.0" encoding="utf-8"?>
<!-- Same brand-500 -> brand-700 diagonal gradient as ic_splash_logo.xml /
     assets/generate.mjs, on a widget-appropriate rounded card instead of
     the app-icon's tighter corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF4AA6"
        android:endColor="#DE0067" />
</shape>
