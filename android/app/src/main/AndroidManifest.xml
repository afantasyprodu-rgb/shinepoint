<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google/Supabase OAuth redirects back into the app via this App
                 Link (HTTPS, not a custom scheme) — see docs/android-capacitor.md.
                 A custom scheme is unverified and any app on the device can
                 register the same one to intercept the OAuth code; autoVerify
                 makes Android confirm this app actually owns shinepoint.app
                 before routing the link here instead of the browser.
                 REQUIRES publishing https://shinepoint.app/.well-known/assetlinks.json
                 (source: public/.well-known/assetlinks.json) declaring this app's
                 signing certificate's SHA-256 fingerprint — without it, verification
                 fails silently and the link just opens in the browser instead of the
                 app. Currently lists the DEBUG keystore's fingerprint only; add the
                 release keystore's fingerprint there too before shipping a signed
                 build through any channel other than this sideloaded debug APK. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="shinepoint.app" android:pathPrefix="/auth/callback" />
            </intent-filter>

            <!-- Tapping the home-screen widget (ShinePointWidgetProvider) opens
                 here — caught by the same appUrlOpen listener as the OAuth
                 link, in NativeBridge.jsx. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shinepoint" android:host="widget" />
            </intent-filter>

        </activity>

        <!-- Home-screen widget: shows the signed-in user's nearest active
             booking, or a "Book a detail" shortcut if there isn't one. Content
             comes from WidgetBridgePlugin (called from JS); this receiver only
             redraws whatever was last written to SharedPreferences. -->
        <receiver
            android:name=".ShinePointWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Photo pickers are plain <input type="file">, which the WebView hands to
         the system file/camera chooser. Several OEM choosers (confirmed:
         Samsung) silently drop the "Camera" option from that chooser if the
         app hasn't declared CAMERA, leaving only Files/Gallery — so it's
         needed even though nothing here calls the Camera API directly.
         Location is required: the map's locate-me button calls
         navigator.geolocation. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Detailer-side en-route GPS tracking (src/lib/tracking.js), so pings
         keep posting while the phone is locked/backgrounded during a drive.
         FOREGROUND_SERVICE / FOREGROUND_SERVICE_LOCATION / POST_NOTIFICATIONS
         and the service declaration come from
         @capacitor-community/background-geolocation's own manifest (merged
         automatically by `cap sync`) — only ACCESS_BACKGROUND_LOCATION needs
         declaring here, since Play policy requires the app itself (not a
         library) to request it explicitly. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
</manifest>
