# Copy this file to android/keystore.properties (gitignored — never commit
# the real one) and fill in the values from the upload keystore you generate
# locally. See docs/android-capacitor.md's "Release build -> Play Store"
# section for the keytool command and full walkthrough.
#
# storeFile is relative to android/ (this file's own directory).

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
