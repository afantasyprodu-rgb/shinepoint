<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>ShinePoint</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- App-Bound Domains (see capacitor.config.ts -> ios.limitsNavigations…).
	     The webview is served local content under shinepoint.app; supabase.co
	     is included for any in-webview Supabase calls. Remove a domain here and
	     the matching navigation is blocked. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>shinepoint.app</string>
		<string>supabase.co</string>
	</array>

	<!-- Uses only standard OS-provided cryptography (TLS/ATS, Keychain); no
	     proprietary or export-restricted crypto, so the App Store Connect
	     export-compliance question resolves without a prompt per upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Google/Supabase OAuth redirects back into the app via this custom
	     scheme — Android equivalent is the intent-filter in
	     android/app/src/main/AndroidManifest.xml. See docs/android-capacitor.md
	     for the matching Supabase redirect-URL setup (same URL both platforms). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shinepoint</string>
			</array>
		</dict>
	</array>

	<!-- Required by Apple for any camera/photo-library access, even through
	     a plain HTML <input type=file> in the webview (job before/after
	     photos, avatar/vehicle photo upload) — missing these strings gets
	     the app rejected in review, not just a runtime prompt. -->
	<key>NSCameraUsageDescription</key>
	<string>Used to take before/after photos of the vehicle during a detailing job, and to add a profile or vehicle photo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to pick before/after job photos or a profile/vehicle photo from your library.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Used to save photos you take back to your library.</string>

	<!-- Used to center the map on your location and show live detailer
	     tracking during a booking. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to center the map on your location and show live tracking during a booking.</string>

	<!-- Detailer-side en-route GPS tracking (src/lib/tracking.js): the
	     "Always" string + UIBackgroundModes below let location updates keep
	     posting while the phone is locked during a drive. Required by
	     @capacitor-community/background-geolocation — see
	     docs/ios-capacitor.md for the matching "Location updates" background
	     mode capability that also needs enabling in Xcode's Signing &
	     Capabilities tab. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Used to share your live location with the customer while a job is en route, including while your phone is locked.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
