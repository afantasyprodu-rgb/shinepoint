# Copy this file to .env and fill in your Supabase project credentials.
# Find them in your Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe publishable key (pk_test_... or pk_live_...). Safe to expose to the
# browser. Dashboard -> Developers -> API keys.
# The SECRET key (rk_/sk_) and webhook secret are NEVER put here — set them as
# Supabase Edge Function secrets:
#   supabase secrets set STRIPE_SECRET_KEY=rk_test_... \
#                        STRIPE_WEBHOOK_SECRET=whsec_... \
#                        PLATFORM_FEE_PERCENT=15
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Google Places API key (web-restricted — HTTP referrer). Used for address
# autocomplete on the onboarding/booking address fields. Cloud Console ->
# APIs & Services -> Credentials. Restrict to "Places API (New)" only.
# Separate keys exist for the Android/iOS Capacitor builds (app-restricted,
# not referrer-restricted) — see AddressAutocomplete.jsx for platform pick.
VITE_GOOGLE_PLACES_API_KEY=your-web-restricted-places-key
