# Copy this file to .env and fill in your Supabase project credentials.
# Find them in your Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe publishable key (pk_test_... or pk_live_...). Safe to expose to the
# browser. Dashboard -> Developers -> API keys.
# The SECRET key (rk_/sk_) and webhook secret are NEVER put here â€” set them as
# Supabase Edge Function secrets:
#   supabase secrets set STRIPE_SECRET_KEY=rk_test_... \
#                        STRIPE_WEBHOOK_SECRET=whsec_... \
#                        PLATFORM_FEE_PERCENT=15
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Google Places API key (web-restricted â€” HTTP referrer). Used for address
# autocomplete on the onboarding/booking address fields. Cloud Console ->
# APIs & Services -> Credentials. Restrict to "Places API (New)" only.
# Separate keys exist for the Android/iOS Capacitor builds (app-restricted,
# not referrer-restricted) â€” see AddressAutocomplete.jsx for platform pick.
VITE_GOOGLE_PLACES_API_KEY=your-web-restricted-places-key

# Cloudflare Turnstile SITE key (public, safe in the browser) â€” bot
# protection on password login and the signup email-code send.
# Get a free pair at https://dash.cloudflare.com -> Turnstile -> Add site.
#
# BOTH halves are required or captcha does nothing:
#   1. this SITE key here (and in Vercel env vars), and
#   2. the SECRET key pasted into Supabase Dashboard -> Authentication ->
#      Attack Protection -> enable CAPTCHA, provider "Turnstile".
# Leave unset and the widget doesn't render and auth works as before â€”
# which is also why enabling (2) without (1) locks everyone out: Supabase
# would demand a token the client never sends. Set the site key first.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Google OAuth Client ID (Web application) for the "Continue with Google"
# button â€” enables the Google Identity Services flow in
# src/lib/googleIdentity.js, which gets an ID token directly from Google
# with no redirect through Supabase's own domain. Without this, the
# account picker shows "to continue to <project-ref>.supabase.co" instead
# of shinepoint.app, since the default signInWithOAuth() flow bounces
# through Supabase to complete the exchange.
#
# Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Application type "Web application".
# Authorized JavaScript origins: https://shinepoint.app (+ http://localhost:5173
# for dev). This is a SEPARATE client ID from whatever Supabase's own
# Google provider config uses in the dashboard â€” don't reuse that one here.
# Leave unset and the button falls back to the old signInWithOAuth redirect
# flow unchanged (also always the case on native/Capacitor â€” Google blocks
# its OAuth flow inside embedded webviews, so native keeps the system-browser
# redirect regardless of this key).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Stadia Maps tile API key â€” the detailer map (DetailerMap.jsx) uses
# Stadia's outdoors basemap for both light and dark mode. Stadia's free tier
# has no trial expiry, just needs a key from
# https://client.stadiamaps.com/signup/. Leave unset and the map falls back
# to plain OpenStreetMap tiles â€” it still works, just with OSM's busier
# default look.
VITE_STADIA_API_KEY=your-stadia-maps-api-key

# ---------------------------------------------------------------------------
# Agent Booking API (Supabase Edge Function secrets — NOT VITE_ / not in git)
# Set via: supabase secrets set AGENT_API_KEY_HASH=<sha256-hex-of-key>
# Optional plaintext for local smoke only: AGENT_API_KEY=...
# Multiple hashes: AGENT_API_KEY_HASHES=hex1,hex2
# See docs/agent-api.md
# AGENT_API_KEY_HASH=
# AGENT_API_KEY=
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ShinePoint MCP server (local host env — NOT VITE_). Never commit the real key.
# SHINEPOINT_AGENT_API_BASE=https://ggcfwwpmclypcexiprro.supabase.co/functions/v1/agent-v1
# SHINEPOINT_AGENT_API_KEY=your-plaintext-agent-api-key
# ---------------------------------------------------------------------------
