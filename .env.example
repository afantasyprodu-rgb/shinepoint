# Copy this file to .env and fill in your Supabase project credentials.
# Find them in your Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Mapbox: create a free account at mapbox.com, then copy your
# "Default public token" from account.mapbox.com
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
