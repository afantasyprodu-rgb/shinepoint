# Copy this file to .env and fill in your Supabase project credentials.
# Find them in your Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Mapbox: create a free account at mapbox.com, then copy your
# "Default public token" from account.mapbox.com
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Stripe publishable key (pk_test_... or pk_live_...). Safe to expose to the
# browser. Dashboard -> Developers -> API keys.
# The SECRET key (rk_/sk_) and webhook secret are NEVER put here — set them as
# Supabase Edge Function secrets:
#   supabase secrets set STRIPE_SECRET_KEY=rk_test_... \
#                        STRIPE_WEBHOOK_SECRET=whsec_... \
#                        PLATFORM_FEE_PERCENT=15
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
